{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' http://localhost:* https://REEMPLAZAR-CON-DOMINIO-REAL-DE-LA-FUNDACION.example"
        }
      ]
    }
  ]
}
