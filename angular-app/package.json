  "scripts": {
    "ng": "ng",
    "config": "node scripts/inject-supabase-env.mjs --dev && node scripts/inject-supabase-env.mjs",
    "prestart": "npm run config",
    "start": "ng serve --configuration development",
    "prebuild": "npm run config",
    "build": "ng build",
