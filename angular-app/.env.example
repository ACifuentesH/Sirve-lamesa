# Copia este archivo a .env y rellénalo. .env está fuera de git: ninguna clave
# vuelve a entrar en el repositorio, que es público.
#
# Supabase → Project Settings → API Keys.
#
# Usa la clave publicable (sb_publishable_...), no la anon heredada: la anon es un JWT
# que estuvo versionado en este repositorio y quedó comprometida para siempre.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# PENDIENTE (issue #1): web de la Fundación Ayúdate. Vacía, el botón de salida no navega.
URL_FUNDACION=
