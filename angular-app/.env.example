# Copia este archivo a .env y rellena los valores reales antes de levantar la app.
# .env está fuera de git.
#
# La clave publicable (sb_publishable_…) va en el cliente a propósito: no es un
# secreto (lo que protege los datos son las políticas RLS, no el secreto de la
# clave). Aun así, sin un .env con valores reales la app NO arranca contra
# Supabase: falla con un mensaje legible que dice qué copiar y qué comando correr
# (issue #45 — antes había un respaldo con credenciales reales versionadas aquí
# mismo; ya no).
#
# De dónde sacarlas: panel de Supabase del proyecto → Project Settings → Data API
# (Project URL y clave publicable/anon). Si no tienes acceso, pídeselas al equipo.
#
# No reutilices ninguna clave anon JWT que encuentres en el historial de git: quedó
# rechazada por el proyecto (HTTP 401) y está pendiente de rotación formal.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# PENDIENTE (issue #1): web de la Fundación Ayúdate. Vacía, el botón de salida no navega.
URL_FUNDACION=
