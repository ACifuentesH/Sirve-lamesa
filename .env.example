# Copiar a .env y rellenar valores. El .env no se versiona.
#
# Este archivo alimenta dos cosas distintas:
#   - DATABASE_URL ......... solo para aplicar migraciones y seeds contra Postgres.
#   - SUPABASE_* / URL_* ... los inyecta angular-app/scripts/inject-supabase-env.mjs
#                            en src/environments/, que están fuera de git.
#
# Comprueba que el ref del proyecto de DATABASE_URL sea EL MISMO que el de
# SUPABASE_URL. Ya pasó una vez que el .env apuntaba a un proyecto viejo y las
# migraciones se aplicaron donde no tocaba.

# ---------------------------------------------------------------------------
# Aplicación Angular
# ---------------------------------------------------------------------------

# Dashboard de Supabase: Project Settings → Data API.
SUPABASE_URL=
# Clave publicable (anon). NUNCA la service_role: viaja al navegador.
SUPABASE_ANON_KEY=
# Destino del botón de salida (issue #1, pregunta 3: la URL definitiva está pendiente).
URL_FUNDACION=

# ---------------------------------------------------------------------------
# Migraciones y seeds (database/)
# ---------------------------------------------------------------------------

# Supabase — en el dashboard: Connect → copiar URI (o Settings → Database).
#
# Conexión DIRECTA (a veces solo IPv6; en Windows puede dar getaddrinfo ENOENT):
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.xxxxx.supabase.co:5432/postgres
#
# Session pooler (IPv4; recomendado si falla db.xxx): usuario postgres.PROJECT_REF, puerto 5432.
# Ejemplo (la REGIÓN sale en tu panel, ej. us-east-1):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
# PostgreSQL local:
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/sirve_la_mesa
#
# Si la conexión "cuelga" (504): proyecto pausado, red, o PG_CONNECTION_TIMEOUT_MS (ms).

DATABASE_URL=
# PG_CONNECTION_TIMEOUT_MS=15000
